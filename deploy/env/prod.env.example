# PROD: official operation. Template only: it is NOT instantiated on the development PC.
# PROD runs on its own validated host, behind the approved HTTPS edge. Copy to deploy/env/prod.env on THAT host
# (git-ignored), replace every CHANGE_ME with a value generated for PROD and stored in the approved secret store.
#
#   scripts/eqms-env.ps1 -Environment prod -Action up -ConfirmProd
#
# Buckets here are locked (COMPLIANCE, 100 years). Anything written to them, including a mistake, stays. Never point a
# DEV or TEST stack at these names; the backend refuses.

EQMS_ENVIRONMENT=PROD
EQMS_PROJECT=eqms-prod
EQMS_CONTAINER_PREFIX=eqms-prod
# The exact image that passed validation in TEST, by digest. No rebuild between TEST and PROD.
EQMS_BACKEND_IMAGE=eqms-backend@sha256:CHANGE_ME
EQMS_FRONTEND_IMAGE=eqms-frontend@sha256:CHANGE_ME

# Database
POSTGRES_DB=eqms_prod
POSTGRES_USER=eqms_prod
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5632

# Object store
MINIO_API_PORT=9200
MINIO_CONSOLE_PORT=9201
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
APP_MINIO_BUCKET=eqms-prod-gmp-records
APP_MINIO_TEMPLATES_BUCKET=eqms-prod-templates
APP_MINIO_RETENTION_YEARS=100

# Secrets
APP_AUTH_JWT_SECRET=CHANGE_ME
ONLYOFFICE_JWT_SECRET=CHANGE_ME

# Ports and addresses (client traffic enters through nginx on HTTP_PORT / the HTTPS edge)
BACKEND_PORT=5200
FRONTEND_PORT=3200
ONLYOFFICE_PORT=8282
CLAMAV_PORT=3510
HTTP_PORT=80
APP_PUBLIC_URL=https://CHANGE_ME
VITE_APP_URL=https://CHANGE_ME
VITE_ONLYOFFICE_URL=https://CHANGE_ME
VITE_APP_ENV=production
APP_SECURITY_COOKIES_SECURE=true

# No developer tools in PROD: COMPOSE_PROFILES is deliberately not set.

# Backup & Restore (SDS-BR-001). Each environment has its own control database, agent token and encryption key.
BACKUP_CONTROL_DB_PASSWORD=CHANGE_ME
BACKUP_SOURCE_DB_PASSWORD=CHANGE_ME
BACKUP_AGENT_API_TOKEN=CHANGE_ME
BACKUP_GPG_PUBLIC_KEY_FILE=CHANGE_ME_path_to_the_TEST_public_key
BACKUP_T1_DIR=./CHANGE_ME/t1
BACKUP_LEDGER_DIR=./CHANGE_ME/ledger
BACKUP_AGENT_STATE_DIR=./CHANGE_ME/agent
