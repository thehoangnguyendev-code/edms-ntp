# TEST: validation / qualification. Runs the SAME controlled configuration as PROD (docker-compose.gmp.yml), with
# synthetic data only. Copy to deploy/env/test.env (git-ignored), replace every CHANGE_ME with a value generated for TEST
# and used nowhere else.
#
#   scripts/eqms-env.ps1 -Environment test -Action up

EQMS_ENVIRONMENT=TEST
EQMS_PROJECT=eqms-test
EQMS_CONTAINER_PREFIX=eqms-test
# TEST runs the release candidate image built once in DEV, by tag or digest. Never "local" and never rebuilt for PROD.
EQMS_BACKEND_IMAGE=eqms-backend:rc-CHANGE_ME
EQMS_FRONTEND_IMAGE=eqms-frontend:rc-CHANGE_ME

# Database (own database, own volume)
POSTGRES_DB=eqms_test
POSTGRES_USER=eqms_test
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5532
ADMINER_PORT=8181

# Object store (own MinIO container and volume; bucket names carry the environment as a second guard).
# Retention is short so the validation volume can be rebuilt; lock behaviour is still exercised.
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
APP_MINIO_BUCKET=eqms-test-gmp-records
APP_MINIO_TEMPLATES_BUCKET=eqms-test-templates
APP_MINIO_RETENTION_YEARS=1

# Secrets (generate a new value for TEST; do not copy from DEV or PROD)
APP_AUTH_JWT_SECRET=CHANGE_ME
ONLYOFFICE_JWT_SECRET=CHANGE_ME

# Ports and addresses
BACKEND_PORT=5100
FRONTEND_PORT=3100
ONLYOFFICE_PORT=8182
CLAMAV_PORT=3410
MAILHOG_UI_PORT=8125
MAILHOG_SMTP_PORT=1125
HTTP_PORT=8080
APP_PUBLIC_URL=http://localhost:3100
VITE_APP_URL=http://localhost:3100
VITE_ONLYOFFICE_URL=http://localhost:8182
VITE_APP_ENV=staging
APP_SECURITY_COOKIES_SECURE=false

# TEST may use the mail catcher and the database viewer. PROD must not.
COMPOSE_PROFILES=dev-tools

# Backup & Restore (SDS-BR-001). Each environment has its own control database, agent token and encryption key.
BACKUP_CONTROL_DB_PASSWORD=CHANGE_ME
BACKUP_SOURCE_DB_PASSWORD=CHANGE_ME
BACKUP_AGENT_API_TOKEN=CHANGE_ME
BACKUP_GPG_PUBLIC_KEY_FILE=CHANGE_ME_path_to_the_TEST_public_key
BACKUP_T1_DIR=./CHANGE_ME/t1
BACKUP_LEDGER_DIR=./CHANGE_ME/ledger
BACKUP_AGENT_STATE_DIR=./CHANGE_ME/agent
