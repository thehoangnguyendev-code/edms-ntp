# DEV: development. Disposable data, developer tools on, relaxed secrets allowed.
# The running DEV stack uses the repository-root .env (kept as it is). This file documents the same values and the naming
# rule, so DEV can be rebuilt from scratch. Never reuse a value from test.env or prod.env here.
#
#   docker compose up -d                       (reads ./.env)

EQMS_ENVIRONMENT=DEV
EQMS_PROJECT=eqms
EQMS_CONTAINER_PREFIX=eqms
EQMS_BACKEND_IMAGE=eqms-backend:local
EQMS_FRONTEND_IMAGE=eqms-frontend:local

# Database
POSTGRES_DB=eqms-database
POSTGRES_USER=eqms
POSTGRES_PASSWORD=eqms
POSTGRES_PORT=5432
ADMINER_PORT=8081

# Object store. DEV keeps the three original bucket names (they hold existing DEV data). DEV buckets must NOT start with
# eqms-test- or eqms-prod-; the backend refuses to start or to write otherwise.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=eqms-minio
MINIO_ROOT_PASSWORD=eqms-minio-secret
APP_MINIO_BUCKET=eqms-gmp-records
APP_MINIO_TEMPLATES_BUCKET=eqms-templates
APP_MINIO_RETENTION_YEARS=100

# Secrets (DEV defaults are public knowledge; fine only because DEV holds no real data)
APP_AUTH_JWT_SECRET=EQMS_DEV_AUTH_SECRET_CHANGE_ME_32_BYTES_MINIMUM_KEY
ONLYOFFICE_JWT_SECRET=EQMS_DEV_ONLYOFFICE_JWT_SECRET_CHANGE_ME

# Ports and addresses
BACKEND_PORT=5000
FRONTEND_PORT=3000
ONLYOFFICE_PORT=8082
CLAMAV_PORT=3310
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025
APP_PUBLIC_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
VITE_ONLYOFFICE_URL=http://localhost:8082
VITE_APP_ENV=development
APP_SECURITY_COOKIES_SECURE=false

# Backup & Restore (SDS-BR-001). Each environment has its own control database, agent token and encryption key.
BACKUP_CONTROL_DB_PASSWORD=CHANGE_ME
BACKUP_SOURCE_DB_PASSWORD=CHANGE_ME
BACKUP_AGENT_API_TOKEN=CHANGE_ME
BACKUP_GPG_PUBLIC_KEY_FILE=./backups/dev-keys/public.asc
